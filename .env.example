
# ============================================================
# Main MySQL database
# ============================================================
DB_HOST=db
DB_PORT=3306
DB_NAME=onecare
DB_USER=onecare
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password


# ============================================================
# Backend
# ============================================================
BACKEND_PORT=8080
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Frontend
# ============================================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:3000

# --- Prod-like mode (DDP-#49 / DKR-04, docker-compose.prod.yml) --------------
# Runtime API base written into the container's /config.json at start.
# Same-origin /api is correct for staging AND production (the nginx proxy
# forwards it to the backend service) - change only if the API is hosted on
# a different origin. Never put secrets here; this file is public.
RUNTIME_API_BASE_URL=/api
# Image tag pushed by onecare-frontend CI on merges to develop/main.
# Deployments pin an exact SHA (sha-<commit>) and promote the SAME SHA from
# staging to production - no :latest, no rebuilds per environment.
# Local prod-like runs build this tag from Dockerfile.prod instead of pulling.
FRONTEND_IMAGE=ghcr.io/onecaresystems/onecare-frontend:sha-REPLACE_WITH_COMMIT_SHA
# Address the frontend port binds to in prod-like mode. Keep 0.0.0.0 behind a
# load balancer; set 127.0.0.1 when an edge proxy (TLS termination) runs on
# the same host. db/cache/backend stay loopback-only in prod-like mode.
FRONTEND_BIND=0.0.0.0

# ============================================================
# Chatbot
# ============================================================
CHATBOT_PORT=8000
CHATBOT_DB_NAME=onecare_chatbot
CHATBOT_DB_USER=chatbot_app
# MUST be the password hard-coded in
# ../onecare-chatbot/docker/mysql/init/01_schemas_and_users.sql
# (dev/CI password; the script creates chatbot_app with it on the first MySQL start.
#  Changing this alone makes the chatbot fail with "Access denied for user 'chatbot_app'".)
CHATBOT_DB_PASSWORD=chatbot_dev_pw
# Spring Boot -> Django service token.
# settings.py REJECTS anything shorter than 32 characters, so the chatbot cannot boot
# without a real value. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
CHATBOT_SERVICE_TOKEN=CHANGE_ME_generate_a_random_token_at_least_32_characters_long
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_DJANGO_SECRET

# ============================================================
# Redis
# ============================================================
REDIS_HOST=cache
REDIS_PORT=6379

# ============================================================
# JWT
# ============================================================
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRY=1800000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# ============================================================
# Email — use an app password stored only in this file
# ============================================================
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=REPLACE_WITH_YOUR_NEW_EMAIL_APP_PASSWORD
