
# ============================================================
# Main MySQL database
# ============================================================
DB_HOST=db
DB_PORT=3306
DB_NAME=onecare
DB_USER=onecare
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password


# ============================================================
# Backend
# ============================================================
BACKEND_PORT=8080
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Frontend
# ============================================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
PASSWORD_RESET_FRONTEND_BASE_URL=http://localhost:3000

# ============================================================
# Chatbot
# ============================================================
CHATBOT_PORT=8000
CHATBOT_DB_NAME=onecare_chatbot
CHATBOT_DB_USER=chatbot_app
# MUST be the password hard-coded in
# ../onecare-chatbot/docker/mysql/init/01_schemas_and_users.sql
# (dev/CI password; the script creates chatbot_app with it on the first MySQL start.
#  Changing this alone makes the chatbot fail with "Access denied for user 'chatbot_app'".)
CHATBOT_DB_PASSWORD=chatbot_dev_pw
CHATBOT_SERVICE_TOKEN=REPLACE_WITH_A_NEW_RANDOM_TOKEN
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_DJANGO_SECRET

# ============================================================
# Redis
# ============================================================
REDIS_HOST=cache
REDIS_PORT=6379

# ============================================================
# JWT
# ============================================================
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRY=1800000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# ============================================================
# Email — use an app password stored only in this file
# ============================================================
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=REPLACE_WITH_YOUR_NEW_EMAIL_APP_PASSWORD
